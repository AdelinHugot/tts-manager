# Copier ce fichier en `.env` pour le développement local :  cp .env.example .env
# `.env` est ignoré par Git — il ne doit JAMAIS être committé.

# ---------------------------------------------------------------- SERVEUR ---
# Secret, utilisé uniquement par la fonction Netlify netlify/functions/claude.js.
# En production : Netlify › Site settings › Environment variables (scope
# « Functions » suffit ; ne pas cocher « Builds »).
ANTHROPIC_API_KEY=sk-ant-...

# Origines autorisées à appeler /api/claude, séparées par des virgules.
# Les URLs du déploiement Netlify sont ajoutées automatiquement ; ne renseigner
# cette variable que pour un domaine personnalisé.
# ALLOWED_ORIGINS=https://tts-manager.fr

# ----------------------------------------------------------------- CLIENT ---
# ⚠️  Tout ce qui commence par VITE_ est intégré EN CLAIR dans le bundle public.
# N'y mettre aucun secret.
# VITE_PALETTE=Lavande            # Lavande | Menthe | Indigo
# VITE_TIKTOK_CONNECTED=true
# VITE_ASSISTANT_MODE=Rapide      # Rapide | Approfondi
